rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Open access for V3GAS B3TA app
      // Updated: May 24, 2026 - Removed expiration date
      // NOTE: This allows anyone with the database reference to read/write
      // Consider adding authentication in the future for better security
      allow read, write: if true;
    }
  }
}
